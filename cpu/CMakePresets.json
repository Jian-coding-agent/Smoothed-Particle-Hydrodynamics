{
  "version": 2,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "vs2019-x64",
      "displayName": "Visual Studio 2019 x64 (v142, C++17)",
      "description": "Equivalent to running cmake .. from the build directory",
      "generator": "Visual Studio 16 2019",
      "architecture": "x64",
      "toolset": "v142",
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "vs2019-x64-cxx20",
      "displayName": "Visual Studio 2019 x64 (v142, C++20)",
      "description": "Same as above, but with /std:c++20 (requires VS2019 16.11+)",
      "inherits": "vs2019-x64",
      "binaryDir": "${sourceDir}/build-cxx20",
      "cacheVariables": { "SPH_USE_CXX20": "ON" }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "displayName": "Release",
      "configurePreset": "vs2019-x64",
      "configuration": "Release",
      "targets": [ "SPH" ]
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "configurePreset": "vs2019-x64",
      "configuration": "Debug",
      "targets": [ "SPH" ]
    },
    {
      "name": "release-cxx20",
      "displayName": "Release (C++20)",
      "configurePreset": "vs2019-x64-cxx20",
      "configuration": "Release",
      "targets": [ "SPH" ]
    }
  ]
}
