@@ -1839,11 +1850,46 @@
 // ---------------------------------------------------------------------------
 static const int BLK = 256;
 
+// PERF: block size per launch.  Every kernel here is one thread per particle and
+// the heavy ones are fp64-pipe bound (1/64 rate on GeForce), so the step time of a
+// kernel is set by the SM that received the most blocks.  With 256-thread blocks a
+// K=8 rank of the 237k deck (12.7k fluid) launches 50 blocks on a 170-SM card and
+// leaves 120 SMs idle.  Pick the size in {32..256} that minimises the per-SM
+// critical path ceil(ceil(n/bs)/SMs)*bs (ties -> larger).  Per-thread arithmetic is
+// unchanged, so the results are bit-identical.  SPH_BLK=32|64|128|256 forces one.
+static int sph_force_blk = [] {
+    const char* e = getenv("SPH_BLK");
+    const int b = e ? atoi(e) : 0;
+    return (b == 32 || b == 64 || b == 128 || b == 256) ? b : 0;
+}();
+static inline int sph_num_sms()
+{
+    static thread_local int dev = -1, sms = 0;
+    int d = 0;
+    cudaGetDevice(&d);
+    if (d != dev) { dev = d; cudaDeviceGetAttribute(&sms, cudaDevAttrMultiProcessorCount, d); if (sms <= 0) sms = 1; }
+    return sms;
+}
+static inline int bs(int n)
+{
+    if (sph_force_blk) return sph_force_blk;
+    if (n <= 0) return BLK;
+    const long long sms = sph_num_sms();
+    int best = BLK;
+    long long bestT = -1;
+    for (int b = BLK; b >= 32; b >>= 1)
+    {
+        const long long nb = (n + b - 1) / b;
+        const long long t = ((nb + sms - 1) / sms) * b;
+        if (bestT < 0 || t < bestT) { bestT = t; best = b; }
+    }
+    return best;
+}
 // at least one block: a <<<0, BLK>>> launch is an "invalid configuration"
 // error, and a rank of the domain decomposition can own no solid at all (the
 // solid-only kernels then have nothing to do; every one of them starts with an
 // index bound check, so the dummy block is harmless).
-static inline int nblocks(int n) { return n > 0 ? (n + BLK - 1) / BLK : 1; }
+static inline int nb(int n) { const int b = bs(n); return n > 0 ? (n + b - 1) / b : 1; }
 
